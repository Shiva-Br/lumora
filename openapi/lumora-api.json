        "produces": ["application/json"],
        "tags": ["chatbot"],
        "summary": "Create a conversation",
        "parameters": [
          {
            "description": "Conversation options",
            "name": "body",
            "in": "body",
            "schema": {
              "$ref": "#/definitions/CreateConversationInput"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/Envelope"
                },
                {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/definitions/ConversationEntity"
                    }
                  }
                }
              ]
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/Envelope"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/Envelope"
