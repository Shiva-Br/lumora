        "tags": ["users"],
        "summary": "Update the caller's UI preferences",
        "description": "Partial update. theme accepts only 'dark' and language only en|fa|ar; anything else is refused with 400 naming the field rather than coerced.",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "body",
