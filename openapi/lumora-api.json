    "/conversations/start": {
      "post": {
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "description": "One-shot: creates a NEW conversation and runs the first user message\nthrough the shopping-assistant workflow in a single request, streaming\nprogress back as Server-Sent Events (text/event-stream). Unlike\nPOST /conversations it seeds NO greeting — the conversation starts with\nthe user's message and its reply.\n\nThe new conversation's id is delivered two ways so the client has it\nimmediately (and even if the turn later fails): the `X-Conversation-Id`\nresponse header, and a `conversation` SSE event\n({\"conversation_id\":\"...\",\"title\":\"...\"}) emitted before any stage runs.\nEvery other event is identical to POST /conversations/{id}/messages:\n`status`, `requirement`/`candidates`/`marketplace`/`research`/`recommendation`,\n`delta`, `done`, `error`. Consume it with fetch + ReadableStream.",
        "consumes": ["application/json"],
        "produces": ["text/event-stream"],
        "tags": ["chatbot"],
        "summary": "Create a conversation and stream its first message's reply (SSE)",
        "parameters": [
          {
            "description": "First message (and optional title)",
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/StartConversationInput"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE stream",
            "schema": {
              "type": "string"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/Envelope"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/Envelope"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/Envelope"
            }
          }
        }
      }
    },
    "/conversations/{id}": {
      "get": {
