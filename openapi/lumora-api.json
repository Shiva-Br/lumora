          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/Envelope"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/Envelope"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/Envelope"
            }
          }
        }
      },
      "delete": {
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "description": "Soft-deletes an owned conversation and its messages.",
        "produces": ["application/json"],
        "tags": ["chatbot"],
        "summary": "Delete a conversation",
        "parameters": [
          {
            "type": "string",
            "description": "Conversation ID (UUID)",
            "name": "id",
            "in": "path",
            "required": true
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/Envelope"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/Envelope"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/Envelope"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/Envelope"
            }
          }
        }
      }
    },
    "/conversations/{id}/messages": {
      "post": {
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "description": "Posts a user message and runs the shopping-assistant workflow,\nstreaming progress back as Server-Sent Events (text/event-stream).\n\nThe workflow is interactive and pauses twice. While the requirement is\nincomplete it asks at most 3 questions per turn (a `requirement` event\ncarries the profile, readiness and those questions with example answers,\nso a client can render answer chips) and does not search. Once complete\nit discovers candidates and STOPS: it will not compare prices until the\nuser picks products — either in the message text (\"the first two\") or via\nthe `selected_products` array on this request.\n\n\nEvery stage is bracketed by a `status` event\n({\"stage\":\"...\",\"state\":\"started|completed\",\"message\":\"...\"}), so the UI\nalways knows what is running and when to clear its loading indicator.\nStages: `understanding` (routing + category detection), `requirement`\n(extracting answers), `selection` (resolving the product pick),\n`discovery`, `marketplace`, `research`, `recommendation`, and `response`\n(which starts just before the first `delta` and completes when the reply\nis fully streamed). A turn only runs the stages its branch needs, so drive\nthe UI off the events received rather than a fixed sequence. A failing\nstage emits `started` with no `completed`, followed by `error`.\n\nOther event types: `requirement`, `candidates`, `marketplace`, `research`,\n`recommendation` each carrying that stage's complete structured object;\n`delta` for each token of the assistant's prose; `done` at the end;\n`error` on mid-stream failure. Consume it with fetch + ReadableStream (a\nrequest body rules out EventSource). The user turn, each structured stage,\nand the final reply are persisted.",
        "consumes": ["application/json"],
        "produces": ["text/event-stream"],
        "tags": ["chatbot"],
        "summary": "Send a message and stream the shopping-assistant reply (SSE)",
        "parameters": [
          {
            "type": "string",
            "description": "Conversation ID (UUID)",
            "name": "id",
            "in": "path",
            "required": true
          },
          {
            "description": "User message",
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/SendMessageInput"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE stream",
            "schema": {
              "type": "string"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/Envelope"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/Envelope"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/Envelope"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/Envelope"
            }
          }
        }
      }
    },
