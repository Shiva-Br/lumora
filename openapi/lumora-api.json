  "definitions": {
    "ConversationEntity": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MessageEntity"
          }
        },
        "title": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "user_id": {
          "type": "string"
        }
      }
    },
    "CreateConversationInput": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        }
      }
    },
    "Envelope": {
      "type": "object",
      "properties": {
        "data": {},
        "error": {
          "type": "string"
        },
        "success": {
          "type": "boolean"
        }
      }
    },
    "MessageEntity": {
      "type": "object",
      "properties": {
        "ai_request_id": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "conversation_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/MessageKind"
        },
        "payload": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "role": {
          "$ref": "#/definitions/Role"
        },
        "updated_at": {
          "type": "string"
        }
      }
    },
    "MessageKind": {
      "type": "string",
      "enum": [
        "text",
        "requirement",
        "candidates",
        "marketplace",
        "research",
        "recommendation"
      ],
      "x-enum-varnames": [
        "KindText",
        "KindRequirement",
        "KindCandidates",
        "KindMarketplace",
        "KindResearch",
        "KindRecommendation"
      ]
    },
    "Role": {
      "type": "string",
      "enum": ["user", "admin"],
      "x-enum-varnames": ["RoleUser", "RoleAdmin"]
    },
    "SendMessageInput": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        },
        "selected_products": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "StartConversationInput": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        },
        "selected_products": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "title": {
          "type": "string"
        }
      }
    },
    "UserEntity": {
      "type": "object",
      "properties": {
        "avatar_url": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "email_verified": {
          "type": "boolean"
        },
        "first_name": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "last_name": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "phone_verified": {
          "type": "boolean"
        },
        "role": {
          "$ref": "#/definitions/Role"
        },
        "supabase_id": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      }
    },
    "Preferences": {
      "type": "object",
      "description": "Account-scoped UI settings. They follow the person, not the browser.",
      "required": ["theme", "language", "sidebarCollapsed", "_v"],
      "properties": {
        "theme": {
          "type": "string",
          "enum": ["dark"],
          "description": "The only theme the frozen design defines."
        },
        "language": {
          "type": "string",
          "enum": ["en", "fa", "ar"]
        },
        "sidebarCollapsed": {
          "type": "boolean"
        },
        "reducedMotionOverride": {
          "type": "boolean",
          "x-nullable": true,
          "description": "null means no preference expressed — follow the operating system. Distinct from an explicit false."
        },
        "_v": {
          "type": "integer",
          "description": "The CLIENT's storage-migration counter. Persisted and returned untouched; never interpreted by the server."
        }
      }
    },
    "PreferencesPatch": {
      "type": "object",
      "description": "Partial update. An omitted field is left as stored; reducedMotionOverride sent explicitly as null clears it to 'follow the OS'.",
      "properties": {
        "theme": {
          "type": "string",
          "enum": ["dark"]
        },
        "language": {
          "type": "string",
          "enum": ["en", "fa", "ar"]
        },
        "sidebarCollapsed": {
          "type": "boolean"
        },
        "reducedMotionOverride": {
          "type": "boolean",
          "x-nullable": true
        },
        "_v": {
          "type": "integer"
        }
      }
    }
  },
  "securityDefinitions": {
    "BearerAuth": {
      "description": "Supabase access token as \"Bearer <token>\".",
      "type": "apiKey",
      "name": "Authorization",
      "in": "header"
    }
  }
}
