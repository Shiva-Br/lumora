          }
        ],
        "description": "Returns a single owned conversation and its full ordered message\nhistory.",
        "produces": ["application/json"],
        "tags": ["chatbot"],
        "summary": "Get a conversation with its messages",
        "parameters": [
          {
            "type": "string",
