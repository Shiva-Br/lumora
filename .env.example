# Copy to .env.local and fill in. Never commit .env.local.

# Supabase — frontend-safe. These are compiled into the browser bundle by
# design; the publishable key is public and carries no privileges of its own.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Lumora backend origin, e.g. http://localhost:8000
# Server-side only (no NEXT_PUBLIC_ prefix): the browser reaches the backend
# through the /api/me route handler, never directly.
LUMORA_API_URL=http://localhost:8000

# NOTE: SUPABASE_JWT_SECRET and any service-role key are BACKEND-ONLY.
# Never add them here, to a NEXT_PUBLIC_* variable, or to any frontend file.

# Identity provider: 'demo' (client-only UI preview; no backend access),
# 'local' (the closed pilot — username/password against the
# backend, gated at /login) or 'supabase' (the hosted email-OTP + OAuth flow,
# guest-browsable). Defaults to 'local' when unset. The NEXT_PUBLIC_SUPABASE_*
# values above are only required in 'supabase' mode.
NEXT_PUBLIC_AUTH_MODE=demo

# Public website origin used for social preview image URLs.
LUMORA_SITE_URL=http://localhost:3000
